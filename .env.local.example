# Copy to .env.local and fill in for a live-money test flow.
# Leave unset and the booking flow falls back to a mock order (still completes end-to-end).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Required to log into /admin/bookings. Pick any password for the demo.
ADMIN_PASSWORD=

# Random long string used to sign the admin session cookie.
SESSION_SECRET=
