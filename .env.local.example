# Copy to .env.local and fill in.

# --- Database ---------------------------------------------------------------
# Local dev, zero setup: use an embedded file-backed Postgres (PGlite).
#   DATABASE_URL=pglite
#   npm run db:setup:local   # creates ./.pglite and applies migrations
#   npm run db:seed          # seed content + first admin user
#
# Production: a Neon pooled connection string (https://neon.tech).
#   DATABASE_URL=postgres://USER:PASS@HOST/neondb?sslmode=require
#   npm run db:migrate && npm run db:seed
#
# Unset: public site renders from bundled seed content; admin is disabled.
DATABASE_URL=pglite

# --- Image uploads (Vercel Blob) -------------------------------------------------
# Vercel dashboard > Storage > Blob > create store > "Read/Write Token".
BLOB_READ_WRITE_TOKEN=

# --- Admin bootstrap -------------------------------------------------------------
# Used only by `npm run db:seed` to create the first admin user. After that,
# manage the password from /admin/settings.
ADMIN_EMAIL=admin@vinyasa.earth
ADMIN_PASSWORD=

# Random long string used to sign the admin session cookie AND to hash
# visitor IPs for analytics. Generate: openssl rand -hex 32
SESSION_SECRET=

# --- Payments (Razorpay, optional) ---------------------------------------------
# Leave unset and the booking flow falls back to a mock order.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Form notification emails -------------------------------------------------
# Configure shared To / CC / BCC recipients for all forms in Admin > Settings.
# Configure credentials securely in Admin > Settings, or via server environment.
# Gmail: enable 2-Step Verification and use a Google App Password.
SMTP_USER=
SMTP_PASSWORD=
# Leave SMTP_HOST blank to use Gmail; custom SMTP also requires SMTP_PORT.
SMTP_HOST=
SMTP_PORT=465
EMAIL_FROM=
# Alternative: Resend API key plus a verified EMAIL_FROM address.
RESEND_API_KEY=
